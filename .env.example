# Copiar a .env y ajustar. Ninguna de estas variables es obligatoria en desarrollo.

# Puerto HTTP
PORT=3005

# PostgreSQL. Si no se define, se usa SQLite en el archivo DB_PATH.
# DATABASE_URL=postgres://usuario:clave@host:5432/eventia
# DATABASE_SSL=true            # para servicios externos que exigen SSL (p. ej. Neon)
DB_PATH=eventia.db

# Secreto para firmar los JWT. OBLIGATORIO con NODE_ENV=production.
# JWT_SECRET=una-cadena-larga-y-aleatoria
# JWT_EXPIRES_IN=15m

# Contraseña de las cuentas de demostración creadas al iniciar una base vacía.
# SEED_PASSWORD=Eventia2026!

# Número de proxies delante de la app (1 en Render) para que el límite de login vea la IP real.
# TRUST_PROXY=1

# NODE_ENV=production
