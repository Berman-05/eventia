        {
          "name": "Prueba 6a: Usar un token vencido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64 = (o) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(o))).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const ahora = Math.floor(Date.now() / 1000);",
                  "const cuerpo = b64({ alg: 'HS256', typ: 'JWT' }) + '.' + b64({ sub: '4', ver: 0, iat: ahora - 1000, exp: ahora - 60, jti: 'vencido' });",
                  "const firma = CryptoJS.HmacSHA256(cuerpo, pm.collectionVariables.get('jwtSecret')).toString(CryptoJS.enc.Base64).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('token_vencido', cuerpo + '.' + firma);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vencido}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
